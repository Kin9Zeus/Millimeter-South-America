---
/**
 * Muestra de material. Si la imagen real ya esta en `public/media/materiales/`
 * se usa esa; si todavia no, se pinta una veta procedural con el color
 * dominante del material. Nunca hay un hueco roto.
 */
import Picture from './Picture.astro';
import { hasMedia } from '../lib/media';

interface Props {
  slug: string;
  name: string;
  hex: string;
  family: string;
  /** La primera fila de la galería carga sin lazy para no penalizar el LCP. */
  eager?: boolean;
}

const { slug, name, hex, family, eager = false } = Astro.props;
const base = `/media/materiales/${slug}`;
const tieneFoto = hasMedia(`${base}.avif`) || hasMedia(`${base}.webp`) || hasMedia(`${base}.jpg`);
const seed = slug.length * 7;
---

<figure class="swatch" style={`--stone:${hex}`}>
  <div class="swatch__media">
    {
      tieneFoto ? (
        <Picture
          base={base}
          alt={`Textura de ${name}, ${family} disponible en espesor de 1 a 5 milímetros`}
          width={900}
          height={1200}
          eager={eager}
          sizes="(width >= 64rem) 22vw, (width >= 48rem) 30vw, 46vw"
        />
      ) : (
        <svg class="swatch__proc" viewBox="0 0 400 533" preserveAspectRatio="xMidYMid slice" role="img" aria-label={`Muestra de ${name}`}>
          <defs>
            <filter id={`vein-${slug}`} x="-20%" y="-20%" width="140%" height="140%">
              <feTurbulence type="fractalNoise" baseFrequency="0.014 0.05" numOctaves="4" seed={seed} result="n" />
              <feDisplacementMap in="SourceGraphic" in2="n" scale="70" />
              <feGaussianBlur stdDeviation="0.6" />
            </filter>
          </defs>
          <rect width="400" height="533" fill={hex} />
          <g filter={`url(#vein-${slug})`} opacity="0.5">
            <path d="M-40 130 C 120 90, 200 210, 440 150" stroke="white" stroke-width="7" fill="none" opacity="0.5" />
            <path d="M-40 290 C 140 250, 230 360, 440 300" stroke="white" stroke-width="3" fill="none" opacity="0.35" />
            <path d="M-40 400 C 100 380, 260 440, 440 390" stroke="black" stroke-width="5" fill="none" opacity="0.28" />
          </g>
        </svg>
      )
    }
  </div>

  <figcaption class="swatch__caption">
    <span class="swatch__name">{name}</span>
    <span class="swatch__family">{family}</span>
  </figcaption>
</figure>

<style>
  .swatch {
    margin: 0;
    position: relative;
    overflow: hidden;
    background: var(--stone);
  }

  .swatch__media {
    /* 3:4 = formato nativo del generador de imagenes: sin recorte. */
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .swatch__media :global(picture),
  .swatch__media :global(img),
  .swatch__proc {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .swatch__media :global(img),
  .swatch__proc {
    /* El hover acerca la veta, no la tarjeta: se mira el material, no la interfaz. */
    transform: scale(1.001);
    transition: transform 900ms var(--ease-stone);
  }

  .swatch:hover .swatch__media :global(img),
  .swatch:hover .swatch__proc,
  .swatch:focus-within .swatch__media :global(img),
  .swatch:focus-within .swatch__proc {
    transform: scale(1.14);
  }

  .swatch__caption {
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem;
    background: linear-gradient(to top, color-mix(in oklab, var(--color-obsidian) 88%, transparent), transparent);
    color: var(--color-bone);
  }

  .swatch__name {
    font-family: var(--font-display);
    font-size: var(--text-small);
    letter-spacing: 0.02em;
  }

  .swatch__family {
    font-family: var(--font-mono);
    font-size: var(--text-cota);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.6;
  }
</style>
