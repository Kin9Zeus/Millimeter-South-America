---
/**
 * Fondo de hero con dos versiones, compartido por la portada y las páginas interiores.
 *
 * DOS VERSIONES del fondo, elegidas antes del primer pintado por
 * `<html data-motion-mode="on|off">` (ver Base.astro):
 *
 *   on  -> secuencia de fotogramas en un <canvas> (escritorio 16:9 y móvil 9:16), conducida
 *          por el scroll (motion.ts). El poster (primer fotograma) se ve hasta que carga.
 *   off -> una imagen fija pensada para esta zona (`still`, `still-movil`). Es lo que
 *          ve quien elige no animar, tiene el ahorro de datos o una conexión lenta.
 *
 * Por qué canvas y no <video>: ver scripts/optimizar-media.mjs (procesarSecuencia).
 *
 * Convención de nombres (todo lo genera `npm run media`):
 *   frames = '/media/hero/canto'  ->  canto-frames/, canto-movil-frames/, canto-poster.jpg, canto-movil-poster.jpg
 *   still  = '/media/hero/still'  ->  still.{avif,webp,jpg}, still-movil.{avif,webp,jpg}
 *
 * El contenido (titular, texto) va en el slot y debe llevar `data-hero-content`: es lo que el
 * scroll retira cuando la imagen se queda sola.
 */
import { frameSet, hasMedia, media } from '../lib/media';

interface Props {
  /** Ruta base del video sin extensión. */
  frames: string;
  /** Ruta base de la imagen fija sin extensión. */
  still: string;
  /** Recorrido extra de scroll con el hero fijo, en escritorio y en pantalla vertical. */
  run?: string;
  runPortrait?: string;
}
const { frames, still, run = '170svh', runPortrait = '140svh' } = Astro.props;

const framesH = frameSet(frames);
const framesV = frameSet(`${frames}-movil`);
const hayFrames = Boolean(framesH || framesV);
const posterH = media(`${frames}-poster.jpg`);
const posterV = media(`${frames}-movil-poster.jpg`);

// Imagen fija: AVIF y WebP por orientación (el JPG de escritorio es el respaldo del <img>).
const MIME: Record<string, string> = { avif: 'image/avif', webp: 'image/webp' };
const stillSources = (['avif', 'webp'] as const)
  .flatMap((ext) => [
    hasMedia(`${still}-movil.${ext}`) ? { src: `${still}-movil.${ext}`, type: MIME[ext], portrait: true } : null,
    hasMedia(`${still}.${ext}`) ? { src: `${still}.${ext}`, type: MIME[ext], portrait: false } : null,
  ])
  .filter((s): s is { src: string; type: string; portrait: boolean } => s !== null);
const stillFallback = media(`${still}.jpg`) ?? media(`${still}-movil.jpg`);
---

<section
  class:list={['hero', { 'hero--frames': hayFrames }]}
  style={`--hero-run-desktop: ${run}; --hero-run-portrait: ${runPortrait}`}
  data-hero
>
  <div class="hero__sticky">
    <div class="hero__media" data-hero-media>
      {
        stillFallback && (
          <picture class="hero__still">
            {stillSources.map((s) => (
              <source srcset={s.src} type={s.type} media={s.portrait ? '(orientation: portrait)' : undefined} />
            ))}
            <img src={stillFallback} alt="" width="1920" height="1080" loading="lazy" decoding="async" />
          </picture>
        )
      }
      {
        hayFrames && (posterH || posterV) && (
          <picture class="hero__poster">
            {posterV && <source srcset={posterV} media="(orientation: portrait)" />}
            <img src={posterH ?? posterV} alt="" width="1920" height="1080" fetchpriority="high" decoding="async" />
          </picture>
        )
      }
      {
        hayFrames && (
          <canvas
            class="hero__canvas"
            data-hero-canvas
            data-h-dir={framesH?.dir}
            data-h-count={framesH?.count}
            data-v-dir={framesV?.dir}
            data-v-count={framesV?.count}
            aria-hidden="true"
          />
        )
      }
      {/* Marcador hasta que existan las imágenes: nunca hay un hueco roto. */}
      {!stillFallback && !hayFrames && <div class="hero__placeholder" aria-hidden="true" />}
      <!-- Arriba y abajo: legibilidad del encabezado y empalme con la sección siguiente. Fijo. -->
      <div class="hero__scrim"></div>
      <!-- Lateral: da contraste al titular y se retira con el scroll para mostrar la imagen. -->
      <div class="hero__scrim-side" data-hero-scrim-side></div>
    </div>

    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* Recorrido extra del scroll con el hero fijo. */
    --hero-run: var(--hero-run-desktop);
  }

  /* Con la secuencia en movil el recorrido es menor: el gesto tactil recorre mas por toque. */
  @media (orientation: portrait) {
    .hero {
      --hero-run: var(--hero-run-portrait);
    }
  }

  /*
    Version CON animacion: el hero es mas alto que la pantalla y su contenido queda fijo
    (`sticky`) mientras la secuencia avanza con el scroll. Se resuelve con `sticky` en vez
    de con pin de GSAP: es mas fluido, no pelea con el scroll suave y en movil no salta al
    ocultarse la barra del navegador. Sin animacion el hero mide una pantalla y punto.
  */
  :global(:root[data-motion-mode='on']) .hero {
    height: calc(100svh + var(--hero-run));
  }

  .hero__sticky {
    position: relative;
    inset-block-start: 0;
    /*
      MINIMO, no alto fijo. Con `height: 100svh` el contenido que no cabia se
      salia por ARRIBA (alineado al final), quedando debajo del encabezado.
      Con min-height el bloque crece hasta lo que el contenido necesite.
    */
    min-height: 100svh;
    display: grid;
    align-items: end;
    overflow: hidden;
    /*
      `overflow: hidden` no basta: un <video> va en su propia capa de la GPU y
      podia asomar por debajo del hero (se veia el fotograma cortado y su ruido de
      compresion sobre la seccion siguiente). `clip-path` recorta tambien esas capas.
    */
    clip-path: inset(0);
  }

  :global(:root[data-motion-mode='on']) .hero__sticky {
    position: sticky;
  }

  .hero__media {
    position: absolute;
    inset: -6% 0 0;
    z-index: 0;
  }

  /* Con secuencia el fondo no se desplaza (la animacion ya es la propia secuencia):
     sin el 6 % extra por arriba el encuadre coincide con el de los fotogramas. */
  .hero--frames .hero__media {
    inset: 0;
  }

  /* Las tres capas de fondo ocupan todo el medio. 100 % y no 106 %: sumar otro 6 % hacia
     que sobresaliera por abajo (se veia el corte del fondo sobre la seccion siguiente). */
  .hero__still,
  .hero__poster,
  .hero__canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__still img,
  .hero__poster img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Por defecto (sin JS o modo sin animacion): imagen fija. La secuencia solo se muestra
     en modo `on`, y solo si existe (`hero--frames`). */
  .hero__poster,
  .hero__canvas {
    display: none;
  }

  :global(:root[data-motion-mode='on']) .hero--frames .hero__still {
    display: none;
  }

  :global(:root[data-motion-mode='on']) .hero--frames .hero__poster,
  :global(:root[data-motion-mode='on']) .hero--frames .hero__canvas {
    display: block;
  }

  .hero__placeholder {
    width: 100%;
    height: 100%;
    background:
      radial-gradient(120% 90% at 20% 10%, #2a2724 0%, transparent 60%),
      radial-gradient(90% 70% at 85% 80%, #3a2a1d 0%, transparent 55%),
      linear-gradient(160deg, #101012 0%, #1c1a19 45%, #0d0d0e 100%);
  }

  /* Fijo: oscurece la base (empalme con la seccion siguiente) y una franja arriba para que
     el logotipo blanco se lea aunque el fondo tenga una zona clara justo detras. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, color-mix(in oklab, var(--color-obsidian) 78%, transparent) 0%, transparent 24%),
      linear-gradient(to top, var(--color-obsidian) 0%, color-mix(in oklab, var(--color-obsidian) 30%, transparent) 45%, transparent 75%);
  }

  /* Lateral: contraste del titular. Se retira con el scroll, cuando el titular ya no esta. */
  .hero__scrim-side {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, color-mix(in oklab, var(--color-obsidian) 62%, transparent), transparent 60%);
    pointer-events: none;
  }
</style>
