---
/**
 * Botón flotante de WhatsApp (burbuja abajo a la derecha).
 *
 * Es un enlace normal a `wa.me`: no carga nada de WhatsApp/Meta en la página (la CSP sigue cerrada y no
 * hay rastreo); solo cuando el visitante lo pulsa se abre WhatsApp. Ver 04-Web/Privacidad y cookies.md.
 *
 * Diseño de la marca: burbuja de cobre sobre la obsidiana con el glifo en hueso, un halo que late cada
 * pocos segundos (solo con las animaciones activas) y, en escritorio, una etiqueta que se despliega al
 * pasar el ratón o al enfocar. Se aparta solo del aviso de cookies (variable `--cookie-h`, la pone
 * CookieNotice) y queda por debajo del menú móvil (z-index 45 < 49).
 */
import { SITE, type Locale } from '../consts';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const TEXTO: Record<string, { aria: string; label: string; msg: string }> = {
  es: {
    aria: 'Escríbenos por WhatsApp (se abre en una pestaña nueva)',
    label: 'WhatsApp',
    msg: 'Hola, quiero información sobre MILLIMETER.',
  },
  en: {
    aria: 'Message us on WhatsApp (opens in a new tab)',
    label: 'WhatsApp',
    msg: 'Hello, I would like information about MILLIMETER.',
  },
  fr: {
    aria: 'Écrivez-nous sur WhatsApp (s’ouvre dans un nouvel onglet)',
    label: 'WhatsApp',
    msg: 'Bonjour, je souhaite des informations sur MILLIMETER.',
  },
  ar: {
    aria: 'راسلنا على واتساب (يُفتح في علامة تبويب جديدة)',
    label: 'واتساب',
    msg: 'مرحبًا، أودّ الحصول على معلومات عن MILLIMETER.',
  },
};
const t = TEXTO[lang] ?? TEXTO.en;

// E.164 sin el "+": lo que espera wa.me.
const numero = (SITE.whatsapp ?? '').replace(/\D/g, '');
const href = `https://wa.me/${numero}?text=${encodeURIComponent(t.msg)}`;
---

{
  numero && (
    <a class="wa" href={href} target="_blank" rel="noopener noreferrer" aria-label={t.aria} data-whatsapp>
      <span class="wa__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="28" height="28" focusable="false">
          <path
            fill="currentColor"
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
          />
        </svg>
      </span>
      <span class="wa__label">{t.label}</span>
    </a>
  )
}

<style>
  .wa {
    position: fixed;
    inset-inline-end: max(1.25rem, env(safe-area-inset-right));
    inset-block-end: calc(max(1.25rem, env(safe-area-inset-bottom)) + var(--cookie-h, 0px));
    z-index: 45;
    display: inline-flex;
    align-items: center;
    height: 3.5rem;
    border-radius: 999px;
    color: var(--color-bone);
    text-decoration: none;
    background: linear-gradient(145deg, var(--color-copper-lift) 0%, var(--color-copper) 62%);
    box-shadow:
      0 12px 32px rgb(0 0 0 / 0.5),
      0 2px 6px rgb(0 0 0 / 0.35),
      inset 0 1px 0 rgb(255 255 255 / 0.22);
    transition:
      inset-block-end 420ms var(--ease-stone),
      transform 320ms var(--ease-stone),
      box-shadow 320ms var(--ease-stone);
    -webkit-tap-highlight-color: transparent;
  }

  .wa:hover {
    transform: translateY(-2px);
    box-shadow:
      0 16px 38px rgb(0 0 0 / 0.55),
      0 3px 8px rgb(0 0 0 / 0.4),
      inset 0 1px 0 rgb(255 255 255 / 0.28);
  }

  .wa:active {
    transform: translateY(0) scale(0.97);
  }

  .wa:focus-visible {
    outline: 2px solid var(--color-bone);
    outline-offset: 3px;
  }

  .wa__icon {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    flex: none;
  }

  /* Etiqueta: se despliega en escritorio al pasar el ratón o enfocar. En móvil no hay hover y la burbuja
     sola ya es reconocible. */
  .wa__label {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    font-family: var(--font-mono);
    font-size: var(--text-cota);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition:
      max-width 420ms var(--ease-stone),
      opacity 320ms var(--ease-stone),
      padding 420ms var(--ease-stone);
  }

  @media (hover: hover) and (width >= 64rem) {
    .wa:hover .wa__label,
    .wa:focus-visible .wa__label {
      max-width: 8rem;
      opacity: 1;
      padding-inline-end: 1.4rem;
    }
  }

  @media (width >= 64rem) {
    .wa {
      inset-inline-end: 2rem;
      inset-block-end: calc(2rem + var(--cookie-h, 0px));
      height: 3.75rem;
    }

    .wa__icon {
      width: 3.75rem;
      height: 3.75rem;
    }

    .wa__icon svg {
      width: 30px;
      height: 30px;
    }
  }

  /* Halo que late: llama la atención sin ser un anuncio. Solo con las animaciones activas. */
  :global(:root[data-motion-mode='on']) .wa::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 2px solid var(--color-copper-lift);
    opacity: 0;
    pointer-events: none;
    animation: wa-halo 3.6s var(--ease-stone) 2.2s infinite;
  }

  /* Entrada: aparece un instante después de cargar la página, sin robarle protagonismo al titular. */
  :global(:root[data-motion-mode='on']) .wa {
    animation: wa-in 700ms var(--ease-stone) 1.1s both;
  }

  @keyframes wa-halo {
    0% {
      opacity: 0.6;
      transform: scale(1);
    }
    70%,
    100% {
      opacity: 0;
      transform: scale(1.55);
    }
  }

  @keyframes wa-in {
    from {
      opacity: 0;
      transform: translateY(1.25rem) scale(0.85);
    }
  }

  /* Al imprimir no tiene sentido un botón flotante. */
  @media print {
    .wa {
      display: none;
    }
  }
</style>
