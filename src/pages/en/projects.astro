---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import Picture from '../../components/Picture.astro';
import { PROJECTS, ROUTES, SITE } from '../../consts';
import { hasMedia } from '../../lib/media';

const lang = 'en' as const;
const title = 'Projects — built work in MILLIMETER stone';
const description =
  'Curved floating vanity in Austin, marble arch in San Diego, cabinet detail in Houston: real pieces with their material, thickness and finish.';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE.url}/en` },
    { '@type': 'ListItem', position: 2, name: 'Projects', item: `${SITE.url}/en/projects` },
  ],
};
---

<Base title={title} description={description} lang={lang} schema={breadcrumb}>
  <PageHero
    media={{ frames: '/media/hero/proyectos', still: '/media/hero/still-proyectos' }}
    eyebrow="Projects"
    title={['Real work.', 'Real precision.']}
    measure="1 mm + 5 mm"
    lead="We work with architects, designers and private clients on high-end residential and commercial projects. These are built pieces, with the full specification."
  />

  {
    PROJECTS.map((p, i) => {
      const titulo = typeof p.title === 'string' ? p.title : p.title.en;
      const base = `/media/proyectos/${p.slug}`;
      const hayFoto = hasMedia(`${base}.avif`) || hasMedia(`${base}.jpg`);
      return (
        <Section measure={p.thickness} label={p.location.split('·')[0].trim()} light={i % 2 === 1}>
          <article class="proj">
            <figure class="proj__media reveal">
              {
                hayFoto ? (
                  <Picture
                    base={base}
                    alt={`${titulo}: ${p.piece.en} in ${p.material}, ${p.thickness} thick`}
                    width={1600}
                    height={1200}
                    eager={i === 0}
                    sizes="(width >= 64rem) 56vw, 92vw"
                  />
                ) : (
                  <div class="proj__placeholder" aria-hidden="true" />
                )
              }
            </figure>

            <div class="proj__body">
              <h2 class="t-h2">{titulo}</h2>
              <p class="lead reveal">{p.piece.en}</p>

              <dl class="proj__specs reveal">
                <div><dt>Material</dt><dd>{p.material}</dd></div>
                <div><dt>Thickness</dt><dd>{p.thickness}</dd></div>
                <div><dt>Finish</dt><dd>{p.finish.en}</dd></div>
                <div><dt>Location</dt><dd>{p.location}</dd></div>
              </dl>

              {
                p.details.en.length > 0 && (
                  <div class="proj__pieces reveal">
                    <p class="cota proj__piecesTitle">Pieces</p>
                    <ul>
                      {p.details.en.map((d) => <li>{d}</li>)}
                    </ul>
                  </div>
                )
              }
            </div>
          </article>
        </Section>
      );
    })
  }

  <Section measure="?" label="South America">
    <h2 class="t-h2" data-split-lines>
      <span class="line-mask"><span>The next one</span></span>
      <span class="line-mask"><span>could be yours.</span></span>
    </h2>
    <p class="lead reveal">
      MILLIMETER arrives in South America with built work behind it, but none here yet. If
      you are designing something conventional stone cannot solve, this is a good moment.
    </p>
    <div class="actions">
      <a class="btn btn-solid" href={ROUTES.contacto.en}>Let's talk about your project</a>
      <a class="btn" href={ROUTES.surAmerica.en}>Meet the representation</a>
    </div>
  </Section>
</Base>
