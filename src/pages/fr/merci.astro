---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import DimensionLine from '../../components/DimensionLine.astro';
import { ROUTES, SITE } from '../../consts';

const lang = 'fr' as const;
---

<Base
  title="Demande reçue — MILLIMETER by Casanova"
  description="Nous avons bien reçu votre demande. Nous répondons sous un jour ouvré."
  lang={lang}
  noindex
>
  <Section measure="OK" label="Reçu">
    <div class="thanks">
      <p class="cota thanks__eyebrow">Demande reçue</p>
      <h1 class="thanks__title">Merci. Nous vous lisons.</h1>
      <p class="lead">
        Votre demande est dans la boîte de réception d’Oscar. C’est un architecte qui répond, pas
        un répondeur automatique : la réponse aura du contenu.
      </p>

      <DimensionLine value="Sous un jour ouvré" scale={0.6} animate={false} class="u-mt" />

      <div class="thanks__next">
        <h2 class="cota">En attendant</h2>
        <ul>
          <li><a href={ROUTES.materiales.fr}>Les 12 matériaux du catalogue</a></li>
          <li><a href={ROUTES.tecnologia.fr}>Comment fonctionne le système, en détail</a></li>
          <li><a href={ROUTES.proyectos.fr}>Des réalisations, avec leur fiche complète</a></li>
          <li><a href={SITE.instagram} rel="noopener" target="_blank">Casanova South America sur Instagram</a></li>
        </ul>
      </div>

      <p class="thanks__note">
        Vous avez oublié une pièce jointe ? Envoyez-la à <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
    </div>
  </Section>
</Base>
