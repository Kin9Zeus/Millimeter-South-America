---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import StoneSwatch from '../../components/StoneSwatch.astro';
import { MATERIALS, ROUTES, SITE } from '../../consts';
import { FAMILY_NAMES } from '../../i18n/ui';

const lang = 'ar' as const;
const title = 'المواد — رخام وكوارتزيت وترافرتين من MILLIMETER';
const description =
  'Bianco Carrara وCalacatta Venatina وNero Marquina وSahara Noir وVerdi Alpi وسبعة تشطيبات أخرى، متوفرة بسماكة من 1 إلى 5 ملّيمترات.';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'الرئيسية', item: `${SITE.url}/ar` },
    { '@type': 'ListItem', position: 2, name: 'المواد', item: `${SITE.url}/ar/materials` },
  ],
};

const families = [
  { id: 'todos', label: 'الكل' },
  { id: 'marmol', label: FAMILY_NAMES.ar.marmol },
  { id: 'cuarcita', label: FAMILY_NAMES.ar.cuarcita },
  { id: 'travertino', label: FAMILY_NAMES.ar.travertino },
];
---

<Base title={title} description={description} lang={lang} schema={breadcrumb}>
  <PageHero
    media={{ frames: '/media/hero/materiales', still: '/media/hero/still-materiales' }}
    eyebrow="المواد"
    title={['الحجر نفسه.', 'دون السماكة.']}
    measure="12 تشطيبًا"
    lead="عيّنة من المجموعة: رخام وكوارتزيت وترافرتين بعروقها كاملة. إن لم تجد هنا المادة التي تبحث عنها فاسألنا: الكتالوج لا يتوقف عند هذه الصفحة."
  />

  <Section measure="12" label="المعرض">
    <div class="filters" role="group" aria-label="تصفية المواد بحسب العائلة">
      {
        families.map((f, i) => (
          <button type="button" class:list={['filter', { 'is-active': i === 0 }]} data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            {f.label}
          </button>
        ))
      }
    </div>

    <ul class="grid" data-material-grid>
      {
        MATERIALS.map((m, i) => (
          <li class="reveal" data-family={m.family}>
            <StoneSwatch slug={m.slug} name={m.name} hex={m.hex} family={FAMILY_NAMES.ar[m.family] ?? m.family} eager={i < 4} />
          </li>
        ))
      }
    </ul>

    <p class="status sr-only" role="status" aria-live="polite" data-filter-status></p>

    <p class="note">
      العيّنات تمثيلية. الحجر الطبيعي لا يتكرر أبدًا: لكل لوح عروقه الخاصة، ويُختار قطعةً قطعةً لكل
      مشروع.
    </p>
  </Section>

  <Section measure="مم" label="الاختيار" light>
    <h2 class="t-h2" data-split-lines>
      <span class="line-mask"><span>المادة هي التي</span></span>
      <span class="line-mask"><span>تحدّد السماكة.</span></span>
    </h2>

    <div class="cols">
      <p class="lead reveal">
        لا تتصرف كل المواد بالطريقة نفسها عند ملّيمتر واحد. فالعروق والصلابة والمسامية هي التي
        تحدّد إلى أي مدى تنحني وأي تشطيب يصمد.
      </p>
      <p class="reveal">
        لذلك يبدأ الحوار من القطعة لا من اللون: أولًا ما يجب أن يفعله الحجر، ثم نختار أيّ حجر.
      </p>
    </div>

    <ul class="guide reveal">
      <li><span class="guide__k">الترافرتين والرخام دقيق العروق</span><span class="guide__v">الأطوع في المنحنيات الضيقة</span></li>
      <li><span class="guide__k">الرخام ذو العروق العريضة اللافتة</span><span class="guide__v">أقصى تأثير على الأسطح المستوية الكبيرة</span></li>
      <li><span class="guide__k">الكوارتزيت</span><span class="guide__v">أصلب؛ منحنيات واسعة وأسطح كثيرة الاستخدام</span></li>
    </ul>

    <div class="actions">
      <a class="btn btn-solid" href={ROUTES.contacto.ar}>اطلب عيّنات</a>
      <a class="btn" href={ROUTES.tecnologia.ar}>اطّلع على المواصفات</a>
    </div>
  </Section>
</Base>

<script>
  const grid = document.querySelector<HTMLElement>('[data-material-grid]');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const status = document.querySelector<HTMLElement>('[data-filter-status]');

  if (grid && buttons.length) {
    const items = Array.from(grid.querySelectorAll<HTMLElement>('li'));

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const family = btn.dataset.filter;
        buttons.forEach((b) => {
          const active = b === btn;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-pressed', String(active));
        });

        let shown = 0;
        items.forEach((li) => {
          const match = family === 'todos' || li.dataset.family === family;
          li.hidden = !match;
          if (match) shown += 1;
        });

        if (status) status.textContent = `عدد المواد الظاهرة: ${shown}.`;
      });
    });
  }
</script>
