---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Section from '../../../components/Section.astro';
import { ROUTES, SITE } from '../../../consts';

const lang = 'ar' as const;
const updated = '2026-09-30';
---

<Base
  title="سياسة الخصوصية — MILLIMETER by Casanova"
  description="ما البيانات التي نجمعها، ولماذا، ومع من نشاركها، وكيف تمارس حقوقك."
  lang={lang}
  noindex
>
  <PageHero eyebrow="قانوني" title={['سياسة', 'الخصوصية.']} measure={`آخر تحديث: ${updated}`} />

  <Section measure="§" label="الخصوصية">
    <div class="prose">
      <p>
        تصف هذه الوثيقة <strong>بدقة</strong> ما يفعله هذا الموقع ببياناتك. كُتبت اعتمادًا على
        الشيفرة الفعلية للموقع لا على نموذج جاهز: فإن لم تجد فيها معالجة ما، فهي غير موجودة.
      </p>

      <h2>1. المسؤول عن المعالجة</h2>
      <p>
        <strong>{SITE.controller.name}</strong>، شركة مؤسَّسة في ولاية {SITE.controller.state}
        ({SITE.controller.countryAr})، ومقرها في {SITE.controller.city}.
      </p>
      <p>
        يعمل التمثيل في أمريكا الجنوبية نيابةً عن هذه الشركة ولا يشكّل كيانًا قانونيًا مستقلًا.
        وتصل الطلبات المرسلة من هذا الموقع مباشرةً إلى صندوق البريد المؤسسي للشركة.
      </p>
      <p>
        <strong>قناة التواصل لأي استفسار عن بياناتك</strong>، بما في ذلك ممارسة حقوقك:
        {' '}<a dir="ltr" href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>

      <h2>2. ما البيانات التي نجمعها</h2>
      <table>
        <thead><tr><th>البيان</th><th>متى</th><th>إلزامي</th></tr></thead>
        <tbody>
          <tr><td>الاسم</td><td>نموذج الاتصال</td><td>نعم</td></tr>
          <tr><td>البريد الإلكتروني</td><td>نموذج الاتصال</td><td>نعم</td></tr>
          <tr><td>المكتب أو الشركة</td><td>نموذج الاتصال</td><td>لا</td></tr>
          <tr><td>الدولة</td><td>نموذج الاتصال</td><td>لا</td></tr>
          <tr><td>الصفة المهنية</td><td>نموذج الاتصال</td><td>لا</td></tr>
          <tr><td>نص الرسالة</td><td>نموذج الاتصال</td><td>نعم</td></tr>
          <tr><td>الاسم والبريد الإلكتروني</td><td>نموذج الوظائف</td><td>نعم</td></tr>
          <tr><td>بلد الإقامة ومجال الاهتمام والتعريف بالنفس</td><td>نموذج الوظائف</td><td>لا</td></tr>
          <tr><td>السيرة الذاتية (ملف PDF بكل ما يحتويه)</td><td>نموذج الوظائف</td><td>نعم</td></tr>
          <tr><td>عنوان IP</td><td>في كل زيارة، ضمن سجلات الخادم</td><td>تلقائي</td></tr>
        </tbody>
      </table>
      <p>
        <strong>لا نستخدم أي تحليلات من جهات خارجية</strong> ولا بكسلات إعلانية ولا تحليلًا لسلوكك ولا
        قرارات آلية. لا يوجد Google Analytics ولا Meta Pixel ولا خرائط حرارية. ولا نبيع بياناتك ولا
        نتنازل عنها لأطراف ثالثة لأغراض تجارية.
      </p>

      <h2>3. لماذا نستخدمها</h2>
      <ul>
        <li><strong>الردّ على طلبك</strong> ومتابعة المحادثة التجارية التي بدأتها.</li>
        <li><strong>تقييم طلب توظيفك</strong>، إن أرسلت واحدًا عبر نموذج الوظائف، والتواصل معك بشأن عملية الاختيار.</li>
        <li><strong>أمن الموقع</strong>: يُستخدم عنوان IP للحدّ من عدد مرات إرسال النماذج ولإيقاف الاستخدام الآلي المسيء.</li>
      </ul>
      <p>
        الأساس القانوني هو <strong>موافقتك الصريحة</strong> عند إرسال النموذج (خانة غير محددة
        افتراضيًا تحدّدها أنت بنفسك) و<strong>مصلحتنا المشروعة</strong> في إبقاء الموقع يعمل
        وبمنأى عن إساءة الاستخدام. وفي نموذج الوظائف تشمل الموافقة صراحةً معالجة سيرتك الذاتية
        لغرض عملية الاختيار.
      </p>
      <p>
        <strong>السيرة الذاتية</strong>: نقبل ملفات PDF فقط. يُرجى ألا تُدرج فيها بيانات غير لازمة
        لتقييم ملفك (أرقام هوية أو صور لأطراف ثالثة أو بيانات صحية). وسنعالج محتوى الملف كما
        ترسله.
      </p>

      <h2>4. مع من نشاركها</h2>
      <p>مع مزوّدي الخدمة اللازمين لتشغيل الموقع فقط:</p>
      <table>
        <thead><tr><th>المزوّد</th><th>الوظيفة</th><th>الموقع</th></tr></thead>
        <tbody>
          <tr><td>Railway</td><td>استضافة الموقع وسجلات الخادم</td><td>الولايات المتحدة</td></tr>
          <tr><td>Resend</td><td>إرسال نماذج الاتصال والوظائف بالبريد الإلكتروني، مع السيرة الذاتية المرفقة</td><td>الولايات المتحدة</td></tr>
          <tr><td>GoDaddy</td><td>تسجيل النطاق وخدمة DNS</td><td>الولايات المتحدة</td></tr>
          <tr><td>WhatsApp (Meta)</td><td>فقط إذا ضغطت على زر واتساب: تُفتح المحادثة في تطبيقهم</td><td>الولايات المتحدة ودول أخرى</td></tr>
        </tbody>
      </table>
      <p>
        <strong>زر واتساب مجرد رابط</strong>: لا يحمّل هذا الموقع شيئًا من واتساب أو ميتا أثناء
        تصفحك. ولا يُفتح واتساب إلا إذا ضغطت عليه، ومنذ تلك اللحظة يعالج واتساب رقمك ورسالتك وفق
        سياسته الخاصة، لا هذا الموقع.
      </p>
      <p>
        وهذا يعني <strong>نقلًا دوليًا للبيانات</strong> إلى الولايات المتحدة. وإن كنت مقيمًا في
        بلد يشترط تشريعه ضمانات خاصة لهذه العمليات، فراسلنا وسنوضح لك الضمانات المطبَّقة.
      </p>

      <h2>5. كم نحتفظ بها</h2>
      <ul>
        <li><strong>طلبات النماذج</strong>: طوال مدة المحادثة التجارية وحتى 24 شهرًا بعد آخر تواصل.</li>
        <li><strong>طلبات التوظيف والسير الذاتية</strong>: طوال عملية الاختيار و<strong>12 شهرًا</strong> كحدّ أقصى من تاريخ استلامها، إلا إذا طلبت حذفها قبل ذلك.</li>
        <li><strong>سجلات الخادم</strong>: تحتفظ بها Railway وفق سياسة الاحتفاظ الخاصة بها.</li>
        <li><strong>تفضيل إشعار ملفات تعريف الارتباط</strong>: في متصفحك حتى تمسح بيانات الموقع. ولا يغادر جهازك أبدًا.</li>
      </ul>

      <h2>6. حقوقك</h2>
      <p>يمكنك أن تطلب منا في أي وقت:</p>
      <ul>
        <li><strong>الاطلاع</strong>: ما البيانات التي نحتفظ بها عنك.</li>
        <li><strong>التصحيح</strong>: تعديل ما هو غير دقيق.</li>
        <li><strong>المحو</strong>: حذف كل ما لدينا عنك.</li>
        <li><strong>الاعتراض والتقييد</strong> على المعالجة.</li>
        <li><strong>قابلية النقل</strong>: تسلّم بياناتك بصيغة مقروءة.</li>
        <li><strong>سحب الموافقة</strong>، دون أن يؤثر ذلك في المعالجات التي تمّت بالفعل.</li>
      </ul>
      <p>
        راسلنا على <a dir="ltr" href={`mailto:${SITE.email}`}>{SITE.email}</a> من العنوان الذي تواصلت
        معنا به. نردّ خلال 30 يومًا تقويميًا كحدّ أقصى. وهذا مجاني ولن نطلب منك تبرير طلبك.
      </p>
      <p>
        وإن رأيت أننا لم نعالج طلبك على الوجه الصحيح، فيمكنك تقديم شكوى إلى سلطة حماية البيانات في
        بلدك.
      </p>

      <h2>7. الأمان</h2>
      <ul>
        <li>كل حركة المرور على الموقع مشفّرة عبر HTTPS.</li>
        <li>يتحقق النموذج من كل حقل ويقيّد طوله في الخادم، لا في المتصفح فقط.</li>
        <li>يحدّ تقييد عدد مرات الإرسال لكل عنوان IP من الإرسال الآلي.</li>
        <li>يطبّق الموقع ترويسات أمان، منها سياسة أمان محتوى (CSP) صارمة.</li>
        <li>لا نحتفظ بشيء في قاعدة بيانات خاصة بنا: يسافر الطلب أو الترشّح عبر البريد الإلكتروني ويبقى في صندوق الوارد المستلِم.</li>
        <li><strong>لا تُحفظ السيرة الذاتية على الموقع</strong>: تُعالَج في الذاكرة وتُفحص وتُرسل بالبريد الإلكتروني. نقبل PDF فقط وحتى 5 ميغابايت؛ ويُفحص محتوى الملف (لا امتداده فقط)، وتُرفض ملفات PDF ذات المحتوى النشط (سكربتات أو مرفقات مضمَّنة)، ويُعاد تسمية الملف قبل إرساله.</li>
        <li>لنموذج الوظائف حدّ أشدّ لعدد مرات الإرسال لكل عنوان IP من حدّ نموذج الاتصال.</li>
      </ul>

      <h2>8. القاصرون</h2>
      <p>
        هذا الموقع موجّه إلى المهنيين في العمارة والتصميم والبناء. وليس موجّهًا إلى القاصرين ولا
        نجمع بياناتهم عن علم.
      </p>

      <h2>9. التعديلات</h2>
      <p>
        إذا تغيّر شيء مهم — كأن تُضاف أدوات تحليل يومًا ما — تُحدَّث هذه الصفحة وتاريخها. والنسخة
        السارية هي دائمًا المنشورة هنا.
      </p>

      <p class="updated">آخر تحديث: {updated}</p>
      <p><a href={ROUTES.cookies.ar}>انظر أيضًا: سياسة ملفات تعريف الارتباط</a></p>
    </div>
  </Section>
</Base>
