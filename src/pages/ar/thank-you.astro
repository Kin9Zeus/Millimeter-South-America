---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import DimensionLine from '../../components/DimensionLine.astro';
import { ROUTES, SITE } from '../../consts';

const lang = 'ar' as const;
---

<Base
  title="تم استلام طلبك — MILLIMETER by Casanova"
  description="لقد استلمنا طلبك. نردّ خلال يوم عمل واحد."
  lang={lang}
  noindex
>
  <Section measure="OK" label="تم الاستلام">
    <div class="thanks">
      <p class="cota thanks__eyebrow">تم استلام الطلب</p>
      <h1 class="thanks__title">شكرًا لك. نحن نقرأ طلبك.</h1>
      <p class="lead">
        طلبك الآن في صندوق وارد أوسكار. من يردّ عليك مهندس معماري لا رد آلي: وسيكون في الرد
        مضمون حقيقي.
      </p>

      <DimensionLine value="خلال يوم عمل واحد" scale={0.6} animate={false} class="u-mt" />

      <div class="thanks__next">
        <h2 class="cota">في الأثناء</h2>
        <ul>
          <li><a href={ROUTES.materiales.ar}>المواد الاثنتا عشرة في الكتالوج</a></li>
          <li><a href={ROUTES.tecnologia.ar}>كيف يعمل النظام بالتفصيل</a></li>
          <li><a href={ROUTES.proyectos.ar}>أعمال منفّذة ببطاقتها الفنية كاملة</a></li>
          <li><a href={SITE.instagram} rel="noopener" target="_blank">Casanova South America على إنستغرام</a></li>
        </ul>
      </div>

      <p class="thanks__note">
        نسيت إرفاق شيء؟ أرسله إلى <a dir="ltr" href={`mailto:${SITE.email}`}>{SITE.email}</a>.
      </p>
    </div>
  </Section>
</Base>
