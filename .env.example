# Copia este archivo a `.env` para desarrollo local.
# En produccion, estas variables se definen en Railway > Variables.
# NUNCA comitees el .env real: esta en .gitignore por una razon.

# ---------------------------------------------------------------- dominio
# URL publica del sitio, sin barra final. Alimenta canonical, hreflang,
# sitemap, robots.txt, Open Graph y llms.txt. Si esta mal, el SEO esta mal.
SITE_URL=https://millimetersouthamerica.com

# ------------------------------------------------------------- formulario
# El formulario de contacto envia por la API de Resend (https://resend.com).
# Sin las tres variables el endpoint responde 503 y la web ensena el email
# directo como salida: nunca finge que envio el mensaje.

# Clave de API de Resend. Empieza por re_
RESEND_API_KEY=

# Remitente. Tiene que ser un dominio verificado en Resend, no un gmail.
# Recomendado: web@tudominio.com
CONTACT_FROM=MILLIMETER Web <web@millimetersouthamerica.com>

# Buzon que recibe las consultas.
CONTACT_TO=info@millimeterbycasanova.com

# ------------------------------------------------------------------ nodo
# Railway lo inyecta solo. En local no hace falta tocarlo.
# PORT=4321
# NODE_ENV=production
